# Example only. Put these names in the Eclipse run configuration (Environment tab) or set them in the
# terminal for the current session only. Do NOT put real values here and do NOT commit a real .env file.
# The LEDGER_ prefix keeps this project away from DB_PASSWORD / JWT_SECRET used by other projects.

# PostgreSQL (database: financial_ledger_task1_db)
LEDGER_DB_USERNAME=postgres
# Optional: if empty, the PostgreSQL driver uses %APPDATA%\postgresql\pgpass.conf
LEDGER_DB_PASSWORD=

# JWT: at least 32 characters, random
LEDGER_JWT_SECRET=change-me-to-a-random-secret-of-32-plus-characters
LEDGER_JWT_EXPIRATION=3600000

# Optional: create an ADMIN user on startup
LEDGER_ADMIN_EMAIL=admin@ledger.local
LEDGER_ADMIN_PASSWORD=change-me

# Optional: fraud sample thresholds
LEDGER_FRAUD_MAX_TRANSFER=100000.00
LEDGER_FRAUD_WINDOW_MINUTES=10
LEDGER_FRAUD_MAX_TRANSACTIONS=5

# Optional: interest scheduler
LEDGER_INTEREST_CRON=0 0 1 1 * *
LEDGER_INTEREST_ZONE=UTC

# Integration tests only (database: financial_ledger_task1_test_db)
LEDGER_TEST_DB_USERNAME=postgres
LEDGER_TEST_DB_PASSWORD=
